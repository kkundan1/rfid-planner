# Copy to .env.local and fill in.
# Where the SQLite database file lives (outside the web folder). Folder must exist and be writable.
DATABASE_PATH=/var/lib/rfid-planner/planner.db
# Long random string; protects the follow-up email trigger. Generate: openssl rand -hex 32
CRON_SECRET=change-me
# Public address of the planner (used in email links)
APP_URL=https://planner.yourcompany.com
# Set to 1 only when testing without HTTPS (cookies are "secure" otherwise)
INSECURE_COOKIES=0
